# ── Server ───────────────────────────────────────────────────────────────
PORT=8080
GIN_MODE=release

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgres://mgoprof:secret@localhost:5432/mgoprof?sslmode=disable

# ── Site ──────────────────────────────────────────────────────────────────
SITE_URL=https://mgoprof.ru
ALLOWED_ORIGIN=https://mgoprof.ru

# ── SMTP ──────────────────────────────────────────────────────────────────
# Resend SMTP relay (recommended, works from Russia):
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Or Yandex:
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USERNAME=your@yandex.ru
# SMTP_PASSWORD=your_app_password

MAIL_FROM_EMAIL=noreply@mgoprof.ru
MAIL_FROM_NAME=MGOPROF

# ── JWT (minimum 32 chars) ────────────────────────────────────────────────
JWT_SECRET=замените_на_случайную_строку_минимум_32_символа

# ── Admin ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL=kms-oleg@mail.ru
ADMIN_NAME=Дубровин Олег
# Generate bcrypt hash:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'password', bcrypt.gensalt(12)).decode())"
#   OR: htpasswd -bnBC 12 "" 'password' | tr -d ':\n'
ADMIN_PASSWORD_HASH=$2y$12$ЗАМЕНИТЕ_НА_РЕАЛЬНЫЙ_BCRYPT_ХЕШ

# ── GeoIP (optional) ─────────────────────────────────────────────────────
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# GEO_DB_PATH=/app/GeoLite2-City.mmdb
