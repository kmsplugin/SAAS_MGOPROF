# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://platform:platform_secret@localhost:5432/platform?sslmode=disable
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_min_32_chars_here_ok_dev

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
MAIL_FROM_EMAIL=noreply@platform.local
MAIL_FROM_NAME=Platform

# ── LiveKit ───────────────────────────────────────────────────────────────────
LIVEKIT_HOST=ws://localhost:7880
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ── Internal service auth ─────────────────────────────────────────────────────
MEDIA_SERVICE_URL=http://localhost:8010
MEDIA_SERVICE_TOKEN=dev_internal_token_change_in_prod

# ── App ───────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
PORT=8080
GIN_MODE=debug

# ── Initial super_admin (bootstrapped on first start) ────────────────────────
ADMIN_EMAIL=admin@platform.local
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Super Admin

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ── AI (optional) ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Speech / Diarization ─────────────────────────────────────────────────────
# HuggingFace token для pyannote/speaker-diarization-3.1 и pyannote/segmentation-3.0
# Получить: https://huggingface.co/settings/tokens (тип: Read)
# Принять ToS: https://huggingface.co/pyannote/speaker-diarization-3.1
#              https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# ── GeoIP (optional) ─────────────────────────────────────────────────────────
GEO_DB_PATH=
GEO_ASN_DB_PATH=
