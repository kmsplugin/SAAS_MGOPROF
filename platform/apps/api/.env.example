# Required
DATABASE_URL=postgres://platform:platform_secret@localhost:5432/platform?sslmode=disable
JWT_SECRET=your_jwt_secret_minimum_32_characters_here

# Server
PORT=8080
GIN_MODE=release
ALLOWED_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# SMTP (Resend)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_resend_api_key
MAIL_FROM_EMAIL=noreply@yourplatform.ru
MAIL_FROM_NAME=Platform

# LiveKit
LIVEKIT_URL=ws://localhost:7880

# Media Service (internal)
MEDIA_SERVICE_URL=http://localhost:8010
MEDIA_SERVICE_TOKEN=dev_internal_token
